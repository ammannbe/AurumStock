includes:
    - ./vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - bootstrap/app.php
        - database
        - public/index.php
        - resources
        - routes
        - tests

    # The level 9 is the highest level
    level: 3

    excludePaths:

    universalObjectCratesClasses:
        - ArrayObject

    ignoreErrors:
        - message: '#Call to an undefined method .*TestCall::#'
          paths:
              - tests/*
        - message: '#Access to an undefined property .*Model::#'
          paths:
              - tests/*
