includes:
    - ./vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - bootstrap/app.php
        - database
        - public/index.php
        - resources
        - routes
        - tests

    # The level 9 is the highest level
    level: 6

    excludePaths:

    universalObjectCratesClasses:
        - ArrayObject

    ignoreErrors:
        - message: '#Call to an undefined method .*TestCall::#'
          paths:
              - tests/*
        # Pest beforeEach() properties on $this (e.g. $this->user) are unknown to PHPStan.
        - message: '#Access to an undefined property Pest\\PendingCalls\\TestCall::\$#'
          paths:
              - tests/*
        - message: '#does not specify its types: TRelatedModel, TDeclaringModel, TResult#'
          paths:
              - app/Filament/Widgets/*
        - message: '#return type with generic class.*does not specify its types: TRelatedModel, TDeclaringModel#'
          paths:
              - app/Models/*
        - message: '#uses generic trait.*HasFactory but does not specify its types: TFactory#'
          paths:
              - app/Models/*
